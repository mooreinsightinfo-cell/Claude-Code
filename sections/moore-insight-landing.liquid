    { "type": "text", "id": "consulting_li1", "label": "Service item 1", "default": "AI tool development & workflow automation" },
    { "type": "text", "id": "consulting_li2", "label": "Service item 2", "default": "Content strategy & cultural storytelling" },
    { "type": "text", "id": "consulting_li3", "label": "Service item 3", "default": "Technology consulting & digital transformation" },
    { "type": "text", "id": "consulting_li4", "label": "Service item 4 (leave blank to hide)", "default": "Educational program design" },
    { "type": "text", "id": "consulting_btn_text", "label": "Button text", "default": "Book a Consultation" },
    { "type": "url", "id": "consulting_btn_link", "label": "Button link" },

    { "type": "header", "content": "Shop \/ Products section" },
    { "type": "text", "id": "shop_kicker", "label": "Kicker label", "default": "The Collection" },
    { "type": "richtext", "id": "shop_heading", "label": "Section heading (italicise a word to make it gold)", "default": "<p>Tools, knowledge & <em>treasures<\/em>.<\/p>" },
    { "type": "textarea", "id": "shop_subtext", "label": "Section description", "default": "Curated offerings for the seeker, the builder, and the scholar. Connect your Shopify catalog to populate this section automatically." },

    { "type": "header", "content": "Quote section" },
    { "type": "textarea", "id": "quote_text", "label": "Quote text (without quotation marks)", "default": "Man, know thyself, and thou shalt know the gods." },
    { "type": "text", "id": "quote_cite", "label": "Citation", "default": "— Inscribed at the Temple of Kemet" },

    { "type": "header", "content": "About section" },
    { "type": "image_picker", "id": "about_image", "label": "About image (leave blank to use default)" },
    { "type": "text", "id": "about_kicker", "label": "Kicker label", "default": "Who We Are" },
    { "type": "richtext", "id": "about_heading", "label": "Section heading", "default": "<p>A house built on legacy.<\/p>" },
    { "type": "richtext", "id": "about_text", "label": "About description (supports multiple paragraphs)", "default": "<p>Moore Insight LLC is a content and consulting practice founded at the intersection of ancient African heritage and modern intelligence. We believe the deepest wisdom of the past holds the keys to mastering the future.<\/p><p>Through media, education, and strategic consulting, we help individuals and organizations think more clearly, build more boldly, and honor the brilliance that came before us.<\/p>" },
    { "type": "text", "id": "about_btn_text", "label": "Button text", "default": "Start a Conversation" },
    { "type": "url", "id": "about_btn_link", "label": "Button link" },

    { "type": "header", "content": "CTA section" },
